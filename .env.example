# Copy this file to .env and fill in the values.

# ---------- Database ----------
# Local development uses a SQLite file. For production, switch the provider in
# prisma/schema.prisma to "postgresql" and use a Postgres URL here.
DATABASE_URL="file:./dev.db"

# ---------- Login ----------
# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Password given to every dummy account created by the seed script.
SEED_DEFAULT_PASSWORD="Welcome@123"

# Set to "false" only if the site is served over plain HTTP (no HTTPS).
# COOKIE_SECURE="false"

# ---------- AI (Google Gemini) ----------
# One key per feature. Create each key in a SEPARATE Google Cloud project
# (Gemini limits are per project). Get keys at https://aistudio.google.com/apikey
GEMINI_KEY_PARENT=""        # Gemini 1: parent AI assistant + weekly parent summaries
GEMINI_KEY_ASSIGNMENT=""    # Gemini 2: checking student notes and assignments
GEMINI_KEY_TEACHER=""       # Gemini 3: teacher writing helper + proctor summaries
GEMINI_KEY_ALERTS=""        # Gemini 4: at-risk student alerts

# Optional: used by any feature whose own key above is empty.
GEMINI_API_KEY=""

# Optional: Gemini model name. If it stops working, "gemini-flash-latest" is tried automatically.
# GEMINI_MODEL="gemini-3.8-flash"

# Optional: AI requests allowed per user per day (controls cost).
# AI_LIMIT_PARENT=30
# AI_LIMIT_ASSIGNMENT=10
# AI_LIMIT_TEACHER=50
# AI_LIMIT_ALERTS=20
